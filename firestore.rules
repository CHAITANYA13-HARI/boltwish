rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /templates/{templateId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /wishes/{wishId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}