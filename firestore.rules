rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validOptionalString(data, field, maxLength) {
      return !data.keys().hasAny([field])
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function validWishData(wishId) {
      let data = request.resource.data;
      let recipient = data.recipientData;
      let content = data.content;
      let snapshot = data.templateSnapshot;

      return data.keys().hasOnly([
          'templateId', 'templateSnapshot', 'recipientData', 'content',
          'username', 'createdAt', 'updatedAt', 'tone', 'visibility',
          'ownerUid', 'expiresAt', 'revealAt', 'passcodeHash'
        ])
        && data.templateId is string
        && data.templateId.size() > 0
        && data.templateId.size() <= 80
        && data.username is string
        && data.username == wishId
        && wishId.matches('^[a-z0-9-]{3,80}$')
        && data.ownerUid is string
        && data.ownerUid.size() > 0
        && data.tone in ['heartfelt', 'playful', 'elegant', 'concise']
        && data.visibility == 'unlisted'
        && data.revealAt is timestamp
        && data.expiresAt is timestamp
        && data.expiresAt == data.revealAt + duration.value(7, 'd')
        && validOptionalString(data, 'passcodeHash', 128)
        && recipient is map
        && recipient.keys().hasOnly([
          'name', 'age', 'eventDate', 'years', 'message', 'from',
          'achievement', 'babyName', 'parentName', 'bride', 'groom', 'to',
          'partnerOne', 'partnerTwo', 'relationship', 'favoriteMemory',
          'quality', 'futureWish', 'effort', 'specialWish',
          'friendshipYears', 'reason', 'impact', 'passcodeHash'
        ])
        && validOptionalString(recipient, 'name', 80)
        && validOptionalString(recipient, 'age', 10)
        && validOptionalString(recipient, 'eventDate', 30)
        && validOptionalString(recipient, 'years', 10)
        && validOptionalString(recipient, 'message', 2500)
        && validOptionalString(recipient, 'from', 80)
        && validOptionalString(recipient, 'achievement', 120)
        && validOptionalString(recipient, 'babyName', 80)
        && validOptionalString(recipient, 'parentName', 80)
        && validOptionalString(recipient, 'bride', 80)
        && validOptionalString(recipient, 'groom', 80)
        && validOptionalString(recipient, 'to', 80)
        && validOptionalString(recipient, 'partnerOne', 80)
        && validOptionalString(recipient, 'partnerTwo', 80)
        && validOptionalString(recipient, 'relationship', 80)
        && validOptionalString(recipient, 'favoriteMemory', 300)
        && validOptionalString(recipient, 'quality', 200)
        && validOptionalString(recipient, 'futureWish', 200)
        && validOptionalString(recipient, 'effort', 300)
        && validOptionalString(recipient, 'specialWish', 300)
        && validOptionalString(recipient, 'friendshipYears', 10)
        && validOptionalString(recipient, 'reason', 300)
        && validOptionalString(recipient, 'impact', 300)
        && content is map
        && content.keys().hasOnly(['title', 'subtitle', 'body', 'highlight', 'quote', 'footer'])
        && validOptionalString(content, 'title', 120)
        && validOptionalString(content, 'subtitle', 200)
        && validOptionalString(content, 'body', 3000)
        && validOptionalString(content, 'highlight', 250)
        && validOptionalString(content, 'quote', 250)
        && validOptionalString(content, 'footer', 120)
        && snapshot is map
        && snapshot.keys().hasOnly([
          'id', 'label', 'chip', 'icon', 'summary', 'theme',
          'fields', 'content', 'order', 'enabled', 'personalizationVersion'
        ])
        && snapshot.id == data.templateId
        && snapshot.label is string
        && snapshot.label.size() <= 80
        && snapshot.fields is list
        && snapshot.fields.size() <= 20;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /templates/{templateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /wishes/{wishId} {
      allow get: if (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin()
        || (
          resource.data.visibility == 'unlisted'
          && (
            !resource.data.keys().hasAny(['revealAt'])
            || resource.data.revealAt == null
            || request.time >= resource.data.revealAt
          )
          && (
            !resource.data.keys().hasAny(['expiresAt'])
            || resource.data.expiresAt == null
            || request.time <= resource.data.expiresAt
          )
        );
      allow list: if isAdmin();
      allow create: if signedIn()
        && validWishData(wishId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin())
        && request.resource.data.updatedAt == request.time
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt
        && validWishData(wishId);
      allow delete: if (signedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
