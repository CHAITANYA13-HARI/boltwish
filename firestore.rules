rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validOptionalString(data, field, maxLength) {
      return !data.keys().hasAny([field])
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function validWishData(wishId) {
      let data = request.resource.data;
      let recipient = data.recipientData;
      let content = data.content;
      let snapshot = data.templateSnapshot;

      return data.keys().hasOnly([
          'templateId', 'templateSnapshot', 'recipientData', 'content',
          'username', 'createdAt', 'updatedAt', 'tone', 'visibility',
          'ownerUid', 'expiresAt', 'revealAt'
        ])
        && data.templateId is string
        && data.templateId.size() > 0
        && data.templateId.size() <= 80
        && data.username is string
        && data.username == wishId
        && wishId.matches('^[a-z0-9-]{3,80}$')
        && data.ownerUid is string
        && data.ownerUid.size() > 0
        && data.tone in ['heartfelt', 'playful', 'elegant', 'concise']
        && data.visibility == 'unlisted'
        && data.revealAt is timestamp
        && data.expiresAt is timestamp
        && data.expiresAt == data.revealAt + duration.value(7, 'd')
        && recipient is map
        && recipient.keys().hasAll(['eventDate'])
        && recipient.keys().hasOnly([
          'name', 'age', 'eventDate', 'years', 'message', 'from',
          'achievement', 'babyName', 'parentName', 'bride', 'groom', 'to',
          'partnerOne', 'partnerTwo', 'relationship', 'favoriteMemory',
          'quality', 'futureWish', 'effort', 'specialWish',
          'friendshipYears', 'reason', 'impact'
        ])
        && validOptionalString(recipient, 'name', 50)
        && validOptionalString(recipient, 'age', 3)
        && recipient.eventDate is string
        && recipient.eventDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && validOptionalString(recipient, 'years', 3)
        && validOptionalString(recipient, 'message', 300)
        && validOptionalString(recipient, 'from', 50)
        && validOptionalString(recipient, 'achievement', 80)
        && validOptionalString(recipient, 'babyName', 50)
        && validOptionalString(recipient, 'parentName', 50)
        && validOptionalString(recipient, 'bride', 50)
        && validOptionalString(recipient, 'groom', 50)
        && validOptionalString(recipient, 'to', 50)
        && validOptionalString(recipient, 'partnerOne', 50)
        && validOptionalString(recipient, 'partnerTwo', 50)
        && validOptionalString(recipient, 'relationship', 80)
        && validOptionalString(recipient, 'favoriteMemory', 220)
        && validOptionalString(recipient, 'quality', 180)
        && validOptionalString(recipient, 'futureWish', 180)
        && validOptionalString(recipient, 'effort', 220)
        && validOptionalString(recipient, 'specialWish', 200)
        && validOptionalString(recipient, 'friendshipYears', 3)
        && validOptionalString(recipient, 'reason', 220)
        && validOptionalString(recipient, 'impact', 220)
        && content is map
        && content.keys().hasOnly(['title', 'subtitle', 'body', 'highlight', 'quote', 'footer'])
        && validOptionalString(content, 'title', 90)
        && validOptionalString(content, 'subtitle', 140)
        && validOptionalString(content, 'body', 1800)
        && validOptionalString(content, 'highlight', 180)
        && validOptionalString(content, 'quote', 180)
        && validOptionalString(content, 'footer', 90)
        && snapshot is map
        && snapshot.keys().hasOnly([
          'id', 'label', 'chip', 'icon', 'summary', 'theme',
          'fields', 'content', 'order', 'enabled', 'personalizationVersion'
        ])
        && snapshot.id == data.templateId
        && snapshot.label is string
        && snapshot.label.size() <= 80
        && snapshot.fields is list
        && snapshot.fields.size() <= 20;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /templates/{templateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /wishes/{wishId} {
      allow get: if !resource.data.keys().hasAny(['expiresAt'])
        || resource.data.expiresAt == null
        || request.time < resource.data.expiresAt
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && validWishData(wishId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validWishData(wishId);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
